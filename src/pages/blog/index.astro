---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConversionBanner from '../../components/ConversionBanner.astro';
import { site } from '../../data/site';
import { posts } from '../../data/blog';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `Blog ${site.name}`,
  url: `${site.url}/blog/`,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.title,
    description: p.description,
    datePublished: p.date,
    image: `${site.url}${p.image}`,
    url: `${site.url}/blog/${p.slug}/`,
  })),
};
---

<BaseLayout
  title="Blog LocationBus | Actualités Transport & Événements en Belgique"
  description="Le blog LocationBus : conseils et actualités sur le transport en bus avec chauffeur pour les grands événements en Belgique (festivals, sport, tourisme)."
  canonicalUrl="/blog/"
  jsonLd={jsonLd}
  lang="fr"
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="container">
        <h1>Blog LocationBus</h1>
        <p>Conseils et actualités transport pour vos événements en Belgique</p>
      </div>
    </section>

    <ConversionBanner />

    <section>
      <div class="container">
        <div class="grid-2 blog-list">
          {posts.map((post) => (
            <article class="card blog-card">
              <a href={`/blog/${post.slug}/`}>
                <img
                  src={post.image}
                  alt={post.imageAlt}
                  width="1600"
                  height="900"
                  loading="lazy"
                  class="blog-card__img"
                />
              </a>
              <div class="blog-card__body">
                <p class="blog-card__date">
                  <time datetime={post.date}>
                    {new Date(post.date).toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                </p>
                <h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2>
                <p>{post.excerpt}</p>
                <p><a href={`/blog/${post.slug}/`} class="btn btn--small">Lire l'article</a></p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-list { align-items: start; }
  .blog-card { padding: 0; overflow: hidden; }
  .blog-card__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .blog-card__body { padding: 1.5rem; }
  .blog-card__date { color: var(--color-muted); font-size: 0.875rem; margin: 0 0 0.5rem; }
  .blog-card h2 { margin-top: 0; font-size: 1.25rem; }
  .blog-card h2 a { color: var(--color-text); }
  .blog-card h2 a:hover { color: var(--color-primary); }
</style>
