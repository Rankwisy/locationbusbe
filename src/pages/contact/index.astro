---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ConversionBanner from '../../components/ConversionBanner.astro';
import { site } from '../../data/site';

const faqItems = [
  { id: 'faq-1', q: 'Quels sont vos tarifs pour une location de bus ?', a: 'Nos tarifs varient selon la durée, la distance et le type de véhicule. Un bus standard de 50 places coûte entre 300 et 950 euros par jour. Contactez-nous pour un devis personnalisé.' },
  { id: 'faq-2', q: 'Comment réserver un bus avec chauffeur ?', a: 'Contactez-nous par téléphone au +32 2 446 01 91 ou par email à info@locationbus.be. Nous vous fournirons un devis détaillé sous 24h.' },
  { id: 'faq-3', q: 'Quelles sont vos zones de service ?', a: 'Nous desservons Bruxelles, toute la Belgique et l\'Europe. Nos destinations populaires incluent Paris, Amsterdam, Frankfurt et Rotterdam.' },
  { id: 'faq-4', q: 'Vos véhicules sont-ils assurés ?', a: 'Oui, tous nos véhicules sont entièrement assurés et nos chauffeurs sont expérimentés et certifiés.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: {
    '@type': 'LocalBusiness',
    name: site.name,
    telephone: site.phone,
    email: site.email,
    address: { '@type': 'PostalAddress', streetAddress: 'Pegasuslaan 5', addressLocality: 'Machelen', postalCode: '1831', addressCountry: 'BE' },
  },
};

const jsonLd = [faqSchema, contactSchema];
---

<BaseLayout
  title="Contact LocationBus | Devis Gratuit Location Bus Bruxelles"
  description="Contactez LocationBus pour un devis gratuit. 7j/7, sans engagement. Réponse sous 24h. +32 2 446 01 91."
  canonicalUrl="/contact/"
  jsonLd={jsonLd}
  lang="fr"
>
  <Header />
  <main id="main">
    <section class="hero">
      <div class="container">
        <h1>Contactez-Nous</h1>
        <p>Devis gratuit, sans engagement. Réponse garantie sous 24h.</p>
      </div>
    </section>

    <ConversionBanner />

    <section>
      <div class="container">
        <div class="grid-2">
          <div>
            <h2>Informations de Contact</h2>
            <p><strong>Téléphone:</strong> <a href={site.phoneTel}>{site.phone}</a></p>
            <p><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
            <p><strong>Adresse:</strong> {site.address}</p>
            <p>{site.cta.service247}</p>
          </div>
          <div>
            <h2>Demander un Devis</h2>
            <form
              id="contact-form"
              name="contact"
              method="POST"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              aria-labelledby="form-title"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p id="form-title" class="visually-hidden">Formulaire de demande de devis</p>
              <p hidden aria-hidden="true">
                <label>Ne pas remplir : <input name="bot-field" autocomplete="off" tabindex="-1" /></label>
              </p>
              <p>
                <label for="contact-name">Votre nom</label><br />
                <input type="text" id="contact-name" name="name" required class="form-input" />
              </p>
              <p>
                <label for="contact-email">Votre email</label><br />
                <input type="email" id="contact-email" name="email" required class="form-input" />
              </p>
              <p>
                <label for="contact-message">Message</label><br />
                <textarea id="contact-message" name="message" rows="5" required class="form-input"></textarea>
              </p>
              <button type="submit" class="btn">Envoyer</button>
            </form>

            <div id="form-success" hidden role="alert" class="form-success">
              <h3>Merci pour votre message !</h3>
              <p>Nous avons bien reçu votre demande de devis et vous répondrons dans les <strong>24 heures</strong>.</p>
              <p>En cas d'urgence, appelez-nous directement au <a href={site.phoneTel}>{site.phone}</a>.</p>
            </div>
          </div>
        </div>

        <h2>Questions Fréquentes</h2>
        <div>
          {faqItems.map((item) => (
            <article id={item.id}>
              <h3>{item.q}</h3>
              <p>{item.a}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .form-success {
    background: #f0fdf4;
    border: 2px solid #22c55e;
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: center;
  }
  .form-success h3 {
    color: #15803d;
    margin-top: 0;
  }
  .form-toast-error {
    color: #dc2626;
    background: #fef2f2;
    border: 1px solid #fca5a5;
    border-radius: 0.25rem;
    padding: 0.75rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success') as HTMLElement | null;

  if (form && success) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const prevText = submitBtn.textContent ?? 'Envoyer';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours…';

      // Remove any previous error toast
      form.querySelector('.form-toast-error')?.remove();

      try {
        const formData = new FormData(form);
        const body = new URLSearchParams();
        formData.forEach((value, key) => body.append(key, value.toString()));
        const res = await fetch('/contact/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        submitBtn.disabled = false;
        submitBtn.textContent = prevText;

        const toast = document.createElement('p');
        toast.className = 'form-toast-error';
        toast.setAttribute('role', 'alert');
        toast.textContent =
          "Une erreur est survenue lors de l'envoi. Veuillez réessayer ou nous appeler au +32 2 446 01 91.";
        form.appendChild(toast);
        setTimeout(() => toast.remove(), 10000);
      }
    });
  }
</script>
